{
  "info": {
    "name": "AI Image Classifier",
    "description": "Collection for testing the AI Image Classification microservice.\n\nEndpoints:\n- GET  /health  — kiểm tra service đang chạy\n- POST /predict — phân loại ảnh (normal hoặc 360°)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Kiểm tra service đang chạy và model đã được load thành công."
      },
      "response": [
        {
          "name": "200 OK — Service running",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"status\": \"ok\"\n}"
        },
        {
          "name": "503 — Model not loaded",
          "status": "Service Unavailable",
          "code": 503,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"detail\": \"Service Unavailable: Model not loaded\"\n}"
        }
      ]
    },
    {
      "name": "Predict — Normal Image",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Ảnh cần phân loại (jpg, png, ...)"
            },
            {
              "key": "image_type",
              "value": "normal",
              "type": "text",
              "description": "Loại ảnh: 'normal' hoặc '360'"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/predict",
          "host": ["{{base_url}}"],
          "path": ["predict"]
        },
        "description": "Phân loại ảnh thường (chụp thẳng). Model: resnet50_normal_best.pth\n\nKết quả trả về label thuộc 1 trong 4 class: bathroom, bedroom, kitchen, livingroom."
      },
      "response": [
        {
          "name": "200 OK — Prediction result",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"label\": \"bedroom\",\n  \"confidence\": 0.9231\n}"
        },
        {
          "name": "400 — Not an image",
          "status": "Bad Request",
          "code": 400,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"detail\": \"File provided is not an image.\"\n}"
        },
        {
          "name": "400 — Invalid image format",
          "status": "Bad Request",
          "code": 400,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"detail\": \"Invalid image file format.\"\n}"
        },
        {
          "name": "500 — Inference error",
          "status": "Internal Server Error",
          "code": 500,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"detail\": \"Inference failed: <error detail>\"\n}"
        }
      ]
    },
    {
      "name": "Predict — 360° Image",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Ảnh panorama 360° cần phân loại"
            },
            {
              "key": "image_type",
              "value": "360",
              "type": "text",
              "description": "Loại ảnh: '360'"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/predict",
          "host": ["{{base_url}}"],
          "path": ["predict"]
        },
        "description": "Phân loại ảnh panorama 360°. Model: resnet50_360_best.pth\n\nKết quả trả về label thuộc 1 trong 4 class: bathroom, bedroom, kitchen, livingroom."
      },
      "response": [
        {
          "name": "200 OK — Prediction result",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"label\": \"kitchen\",\n  \"confidence\": 0.8754\n}"
        }
      ]
    }
  ]
}
