{
  "info": {
    "name": "Order Service API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_BEARER_TOKEN_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [ "{{baseUrl}}" ],
          "path": [ "orders" ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"52379d96-5238-4fd9-8383-bae82736bb3b\",\n  \"customerNote\": \"Giao hàng buổi sáng\",\n  \"shippingAddressName\": \"Minh Hiền\",\n  \"shippingAddressPhone\": \"0123456789\",\n  \"shippingAddressDetail\": \"123 Đường A, Quận B, TP C\",\n  \"shippingMethod\": \"Giao hàng tận nơi\",\n  \"paymentMethod\": \"COD\",\n  \"items\": [\n    {\n      \"productId\": \"prod-1\",\n      \"variantId\": \"var-1\",\n      \"categoryName\": \"Sofa\",\n      \"productName\": \"Sofa Gỗ\",\n      \"color\": \"Nâu\",\n      \"material\": \"Gỗ Sồi\",\n      \"price\": 5000000,\n      \"quantity\": 1,\n      \"imageUrl\": \"https://example.com/sofa.jpg\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Get User Orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/user/52379d96-5238-4fd9-8383-bae82736bb3b",
          "host": [ "{{baseUrl}}" ],
          "path": [ "orders", "user", "52379d96-5238-4fd9-8383-bae82736bb3b" ]
        }
      }
    },
    {
      "name": "Get Order Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/ORD-A1B2C3D4",
          "host": [ "{{baseUrl}}" ],
          "path": [ "orders", "ORD-A1B2C3D4" ]
        }
    },
    {
      "name": "Get Admin Orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/admin?status=PENDING",
          "host": [ "{{baseUrl}}" ],
          "path": [ "orders", "admin" ],
          "query": [
            { "key": "status", "value": "PENDING" }
          ]
        }
      }
    },
    {
      "name": "Update Order Status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/admin/ORD-A1B2C3D4/status",
          "host": [ "{{baseUrl}}" ],
          "path": [ "orders", "admin", "ORD-A1B2C3D4", "status" ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PROCESSING\"\n}"
        }
      }
    }
  ]
}
