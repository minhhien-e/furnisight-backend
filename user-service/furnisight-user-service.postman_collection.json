{
  "info": {
    "name": "FurniSight Clone – User Service",
    "_postman_id": "furnisight-user-service-v2",
    "description": "API collection for user-service.\n\nBase URL: http://localhost:8080/api/v1\n\nVariables:\n- base_url : http://localhost:8080\n- accountId : set after register/login\n- accessToken / refreshToken : set after login\n- otpCode : OTP received via email/phone\n- roleId : UUID of an existing role",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",     "value": "http://localhost:8080" },
    { "key": "accountId",    "value": "" },
    { "key": "accessToken",  "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "otpCode",      "value": "" },
    { "key": "roleId",       "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api","v1","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phoneNumber\": \"+84901234567\",\n  \"dateOfBirth\": \"1995-06-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.accountId) pm.collectionVariables.set('accountId', res.accountId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"john_doe\",\n  \"password\": \"Password@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.accessToken)  pm.collectionVariables.set('accessToken',  res.accessToken);",
                  "if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/refresh-token", "host": ["{{base_url}}"], "path": ["api","v1","auth","refresh-token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.accessToken)  pm.collectionVariables.set('accessToken',  res.accessToken);",
                  "if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Account (confirm OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/verify", "host": ["{{base_url}}"], "path": ["api","v1","auth","verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"token\": \"{{otpCode}}\"\n}"
            }
          }
        },
        {
          "name": "Request Verification OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/auth/verify/request", "host": ["{{base_url}}"], "path": ["api","v1","auth","verify","request"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"EMAIL\",\n  \"destination\": \"john.doe@example.com\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api","v1","auth","logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout All Devices",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/logout-all", "host": ["{{base_url}}"], "path": ["api","v1","auth","logout-all"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/auth/password/change", "host": ["{{base_url}}"], "path": ["api","v1","auth","password","change"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewPassword@456\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password (request OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/password/forgot", "host": ["{{base_url}}"], "path": ["api","v1","auth","password","forgot"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"EMAIL\",\n  \"destination\": \"john.doe@example.com\"\n}"
            }
          }
        },
        {
          "name": "Verify Reset Password Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/password/verify", "host": ["{{base_url}}"], "path": ["api","v1","auth","password","verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{otpCode}}\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/password/reset", "host": ["{{base_url}}"], "path": ["api","v1","auth","password","reset"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{otpCode}}\",\n  \"newPassword\": \"ResetPassword@789\"\n}"
            }
          }
        },
        {
          "name": "Login with Google",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/auth/login/google", "host": ["{{base_url}}"], "path": ["api","v1","auth","login","google"] }
          }
        },
        {
          "name": "Delete Own Account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{base_url}}/api/v1/auth", "host": ["{{base_url}}"], "path": ["api","v1","auth"] }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{base_url}}/api/v1/profile", "host": ["{{base_url}}"], "path": ["api","v1","profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/profile", "host": ["{{base_url}}"], "path": ["api","v1","profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"John Doe\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\",\n  \"dateOfBirth\": \"1995-06-15\",\n  \"gender\": \"MALE\"\n}"
            }
          }
        },
        {
          "name": "Contact Change — Step 1a: Request OTP to current contact",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/profile/contact/change/request", "host": ["{{base_url}}"], "path": ["api","v1","profile","contact","change","request"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"EMAIL_CHANGE\"\n}"
            }
          }
        },
        {
          "name": "Contact Change — Step 1b: Verify OTP at current contact",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/profile/contact/change/verify-current", "host": ["{{base_url}}"], "path": ["api","v1","profile","contact","change","verify-current"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"EMAIL_CHANGE\",\n  \"otpCode\": \"{{otpCode}}\"\n}"
            }
          }
        },
        {
          "name": "Contact Change — Step 2a: Submit new contact",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/profile/contact/change/request-new", "host": ["{{base_url}}"], "path": ["api","v1","profile","contact","change","request-new"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"EMAIL_CHANGE\",\n  \"newContact\": \"new.email@example.com\"\n}"
            }
          }
        },
        {
          "name": "Contact Change — Step 2b: Confirm OTP at new contact",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/profile/contact/change/confirm", "host": ["{{base_url}}"], "path": ["api","v1","profile","contact","change","confirm"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"EMAIL_CHANGE\",\n  \"otpCode\": \"{{otpCode}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin – Account Management",
      "item": [
        {
          "name": "Activate Account",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/accounts/{{accountId}}/activate",
              "host": ["{{base_url}}"],
              "path": ["api","v1","admin","accounts","{{accountId}}","activate"]
            }
          }
        },
        {
          "name": "Ban Account",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/accounts/{{accountId}}/ban",
              "host": ["{{base_url}}"],
              "path": ["api","v1","admin","accounts","{{accountId}}","ban"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Violating terms of service\",\n  \"expiresAt\": \"2026-12-31T23:59:59\"\n}"
            }
          }
        },
        {
          "name": "Unban Account",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/accounts/{{accountId}}/unban",
              "host": ["{{base_url}}"],
              "path": ["api","v1","admin","accounts","{{accountId}}","unban"]
            }
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/accounts/{{accountId}}",
              "host": ["{{base_url}}"],
              "path": ["api","v1","admin","accounts","{{accountId}}"]
            }
          }
        },
        {
          "name": "Assign Role",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/accounts/{{accountId}}/roles/assign",
              "host": ["{{base_url}}"],
              "path": ["api","v1","admin","accounts","{{accountId}}","roles","assign"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleId\": \"{{roleId}}\"\n}"
            }
          }
        },
        {
          "name": "Revoke Role",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/accounts/{{accountId}}/roles/revoke",
              "host": ["{{base_url}}"],
              "path": ["api","v1","admin","accounts","{{accountId}}","roles","revoke"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleId\": \"{{roleId}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin – Role Management",
      "item": [
        {
          "name": "Add Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/admin/roles", "host": ["{{base_url}}"], "path": ["api","v1","admin","roles"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"STAFF\",\n  \"position\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.roleId) pm.collectionVariables.set('roleId', res.roleId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Role",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/admin/roles/{{roleId}}", "host": ["{{base_url}}"], "path": ["api","v1","admin","roles","{{roleId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SENIOR_STAFF\",\n  \"position\": 2\n}"
            }
          }
        },
        {
          "name": "Delete Role",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{base_url}}/api/v1/admin/roles/{{roleId}}", "host": ["{{base_url}}"], "path": ["api","v1","admin","roles","{{roleId}}"] }
          }
        },
        {
          "name": "Assign Permission",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/roles/{{roleId}}/permissions/assign",
              "host": ["{{base_url}}"],
              "path": ["api","v1","admin","roles","{{roleId}}","permissions","assign"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permission\": \"READ_USERS\"\n}"
            }
          }
        },
        {
          "name": "Revoke Permission",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/roles/{{roleId}}/permissions/revoke",
              "host": ["{{base_url}}"],
              "path": ["api","v1","admin","roles","{{roleId}}","permissions","revoke"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permission\": \"READ_USERS\"\n}"
            }
          }
        }
      ]
    }
  ]
}
