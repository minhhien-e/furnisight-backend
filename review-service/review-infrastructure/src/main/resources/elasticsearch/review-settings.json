{
  "analysis": {
    "analyzer": {
      "vi_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "asciifolding", "vi_stop"]
      }
    },
    "filter": {
      "vi_stop": {
        "type": "stop",
        "stopwords": ["và", "của", "cho", "với", "trong", "là", "có", "được", "các", "một", "này"]
      }
    }
  }
}
